{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kanso RSS",
  "version": "0.1.0",
  "identifier": "app.kanso.reader",
  "build": { "frontendDist": "../../web" },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; object-src 'none'; base-uri 'none'; form-action 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": ["../../LICENSE", "../../THIRD_PARTY_NOTICES.md", "../../licenses"],
    "iOS": { "minimumSystemVersion": "15.0" },
    "macOS": { "minimumSystemVersion": "12.0" }
  }
}
